NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Browser origin(s) allowed to make cookie-authenticated writes (CSRF check). Comma separated.
APP_ORIGINS=http://localhost:3000

# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net   Local: mongodb://localhost:27017
# URL-encode special characters in the password (e.g. @ becomes %40). Atlas also needs your IP allow-listed.
MONGODB_URI="mongodb://localhost:27017"
# Database used inside that cluster (the URI usually does not name one).
MONGODB_DB=article_portal

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-change-me
JWT_ISSUER=article-portal
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Set to true when served over HTTPS.
COOKIE_SECURE=false

UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=20

# First admin + sample data, used by `npm run seed`. Quote values containing #.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD="Admin#12345678"   # quoted: an unquoted # starts a comment
SEED_ADMIN_NAME=Portal Admin
SEED_DEMO_ARTICLES=8
